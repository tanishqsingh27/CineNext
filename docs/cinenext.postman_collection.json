{
  "info": {
    "name": "CineNext — booking MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local Java/Spring/MongoDB application. Use a disposable test account. Set credentials privately; do not export populated secrets. Run requests in order. Payments/refunds are simulated. Admin creation uses scripts/Create-Admin.ps1."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "movieId",
      "value": ""
    },
    {
      "key": "showtimeId",
      "value": ""
    },
    {
      "key": "holdId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "ticketCode",
      "value": ""
    },
    {
      "key": "holdKey",
      "value": ""
    },
    {
      "key": "paymentKey",
      "value": ""
    },
    {
      "key": "seatIds",
      "value": "[]"
    },
    {
      "key": "showDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const next = new Date(Date.now() + 86400000 + 330 * 60000);",
          "if(!pm.collectionVariables.get(\"showDate\")) pm.collectionVariables.set(\"showDate\", next.toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Register customer (first use)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Demo\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Authentication succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login customer (existing account)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Authentication succeeded\", () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 List administrator-saved movies",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/movies?size=50",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const movies=pm.response.json().items;",
              "pm.collectionVariables.set(\"movieId\",movies[0]?.id || \"\");",
              "pm.test(\"Save a movie and publish a show through Admin before booking\",()=>pm.expect(movies.length).to.be.greaterThan(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Find an administrator-published show (set showDate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/showtimes?movieId={{movieId}}&date={{showDate}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const shows=pm.response.json();",
              "const show=shows.find(s=>s.availableSeats>=2);",
              "pm.test(\"A future show has two available seats\",()=>pm.expect(Boolean(show)).to.eql(true));",
              "pm.collectionVariables.set(\"showtimeId\",show?.id || \"\");"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Select two available inventory IDs (starts new attempt)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/showtimes/{{showtimeId}}/seats",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const seats=pm.response.json().rows.flatMap(row=>row.seats).filter(seat=>seat.status===\"AVAILABLE\").slice(0,2);",
              "pm.test(\"Two seats are available\",()=>pm.expect(seats.length).to.eql(2));",
              "pm.collectionVariables.set(\"seatIds\",JSON.stringify(seats.map(seat=>seat.id)));",
              "pm.collectionVariables.set(\"holdKey\",pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"paymentKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Hold both seats",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{holdKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/showtimes/{{showtimeId}}/holds",
        "body": {
          "mode": "raw",
          "raw": "{ \"seatIds\": {{seatIds}} }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Seats held\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"holdId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Read owned hold",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/holds/{{holdId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "09 Simulated success (same key is safe to retry)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{paymentKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/holds/{{holdId}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Payment succeeded\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200 && pm.response.json().booking){const b=pm.response.json().booking;pm.collectionVariables.set(\"bookingId\",b.id);pm.collectionVariables.set(\"ticketCode\",b.ticketCode);}"
            ]
          }
        }
      ]
    },
    {
      "name": "10 My bookings",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/bookings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11 Read ticket",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "12 Cancel test booking and release seats",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cancelled\",()=>pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin (optional, provision credentials locally first)",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200) pm.collectionVariables.set(\"adminToken\",pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/overview",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Screens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/screens",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Verify ticket (cancelled test ticket must return 404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/tickets/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketCode\": \"{{ticketCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
