{
  "openapi": "3.1.0",
  "info": {
    "title": "CineNext booking API",
    "description": "Movie discovery, customer authentication, transactional seat holds, simulated payments, QR tickets and role-protected cinema administration.",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Catalogue",
      "description": "Public, read-only catalogue containing only administrator-published entries."
    }
  ],
  "paths": {
    "/api/v1/admin/movies/{id}": {
      "put": {
        "tags": [
          "admin-controller"
        ],
        "operationId": "editMovie",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
