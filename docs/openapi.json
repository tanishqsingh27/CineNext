                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/showtimes": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "Find future showtimes on one date",
        "description": "Date defaults to today in Asia/Kolkata. Past showtimes are omitted. Result is capped at 250 shows per date.",
        "operationId": "showtimes",
        "parameters": [
          {
            "name": "movieId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShowtimeView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/showtimes/{id}/seats": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "Preview a showtime's actual seat inventory",
        "description": "Read-only. Displayed availability can change; this endpoint does not reserve seats.",
        "operationId": "seats",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9-]{1,150}"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SeatMap"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "Search and paginate movies",
        "description": "Literal case-insensitive title search. Other filters are exact. Page starts at 0, size is 1–50.",
        "operationId": "movies",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 10000,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 12,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResultMovie"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/{id}": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "Get one movie",
        "operationId": "movie",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "[a-z0-9-]{1,100}"
