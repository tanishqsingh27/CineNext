  },
  "components": {
    "schemas": {
      "MovieInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "[a-z0-9-]{1,100}"
          },
          "tagline": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "synopsis": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 0
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40,
              "minLength": 0
            },
            "maxItems": 8,
            "minItems": 0
          },
          "language": {
            "type": "string",
            "maxLength": 40,
            "minLength": 0
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "maximum": 300,
            "minimum": 1
          },
          "certificate": {
            "type": "string",
            "maxLength": 12,
            "minLength": 0
          },
          "releaseDate": {
            "type": "string",
            "format": "date"
          },
          "rating": {
            "type": "number",
            "format": "double",
            "maximum": 10,
            "minimum": 0
          },
          "posterUrl": {
            "type": "string",
            "minLength": 1,
            "pattern": "/posters/(orbit-nine|monsoon-letters|the-last-signal|wild-at-heart|midnight-in-jaipur|velocity|paper-moons|the-deep-blue)\\.svg"
          },
          "featured": {
            "type": "boolean"
          }
        },
        "required": [
          "certificate",
          "genres",
          "language",
          "posterUrl",
          "releaseDate",
          "slug",
          "synopsis",
          "tagline",
          "title"
        ]
      },
      "Movie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "synopsis": {
            "type": "string"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "certificate": {
            "type": "string"
          },
          "releaseDate": {
            "type": "string",
            "format": "date"
          },
          "rating": {
            "type": "number",
            "format": "double"
          },
          "posterUrl": {
            "type": "string"
          },
          "backdropUrl": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          }
        }
      },
      "HoldRequest": {
        "type": "object",
        "properties": {
          "seatIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 0
            },
            "maxItems": 8,
            "minItems": 0
          }
        },
        "required": [
          "seatIds"
        ]
      },
      "HoldView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "showtimeId": {
            "type": "string"
          },
          "seatIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seatLabels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalPaise": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "movieTitle": {
            "type": "string"
          },
          "theatreName": {
            "type": "string"
          },
          "screenName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "outcome"
        ]
      },
      "BookingView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "showtimeId": {
            "type": "string"
          },
          "movieTitle": {
            "type": "string"
          },
          "theatreName": {
            "type": "string"
          },
          "screenName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "seatLabels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalPaise": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "ticketCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "canCancel": {
            "type": "boolean"
          }
        }
      },
      "PaymentView": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
