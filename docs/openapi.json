    "/api/v1/theatres": {
      "get": {
        "tags": [
          "Catalogue"
        ],
        "summary": "List theatres, optionally by city",
        "operationId": "theatres",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
