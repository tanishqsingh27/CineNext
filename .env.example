# Copy to .env. Local development defaults contain no credentials.
MONGODB_URI=mongodb://127.0.0.1:27018/cinenext_dev?replicaSet=cinenext-rs
SERVER_PORT=8080
# Keep this aligned with the frontend URL when enabling cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Start-Backend.ps1 generates and saves a random local secret when this is empty.
JWT_SECRET=
